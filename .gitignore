.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/
# Phase 3 packs (derived from pinned checkpoints; rebuilt by the benchmarks)
packs/
# Phase 5A captures (the target layer's tensors per decode token; regenerated by the capture stage, sha256 in digest.json)
experiments/phase5a/*/capture.safetensors
# Phase 5A2: the regenerated capture and the verifier's artifact tensors (regenerated; sha256 in the records and manifest)
experiments/phase5a2/*/capture.safetensors
experiments/phase5a2/*/artifact/*.safetensors
# Phase 6A native core: Cargo build output (rebuilt by `uv sync` / cargo)
native/target/
# Phase 7A: upstream sources fetched at pinned commits by native/fetch_upstream.py (never committed; decision 0014)
native/third_party/
# Phase 7A: expert catalogs written for this machine's checkpoint paths (regenerated by benchmarks/store_check.py; sha256 in prepare.json)
experiments/phase7a/*/catalog.json
# Lossless MoE study (research/lossless_moe): pinned upstream files (fetched, never committed), the codec crate's build
# output, and downloaded weight samples (range-request slices; their sha256 and sources in the sample manifest)
research/lossless_moe/third_party/
research/lossless_moe/codec/target/
experiments/lossless_moe/samples/
experiments/lossless_moe/*/scratch/
